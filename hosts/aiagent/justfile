set fallback := true

_root := `git rev-parse --show-toplevel`

_default:
    @just --list

# build sd card image
build:
    nix build -o "{{ _root }}/results/aiagent" "{{ _root }}#nixosConfigurations.aiagent.config.system.build.sdImage" --builders "$(just _builders)"

# flash sd card image to device (usage: just aiagent::flash /dev/sdX)
flash device:
    zstdcat {{ _root }}/results/aiagent/sd-image/*.img.zst | sudo dd of={{ device }} bs=4M status=progress
    sync

# deploy config to running device over SSH
deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    toplevel=$(nix build "{{ _root }}#nixosConfigurations.aiagent.config.system.build.toplevel" --no-link --print-out-paths)
    nix copy --to ssh://root@aiagent "$toplevel" --no-check-sigs
    ssh root@aiagent "nix-env -p /nix/var/nix/profiles/system --set $toplevel && $toplevel/bin/switch-to-configuration switch"

# push build closure to binary cache
push cache="main":
    nix path-info -r "{{ _root }}/results/aiagent" | xargs attic push {{ cache }}
